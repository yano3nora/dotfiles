{
  "name": "__PROJECT_NAME__",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "run-s test:*",
    "test:tsc": "tsc --noEmit --pretty",
    "test:vitest": "vitest run --passWithNoTests",
    "test:oxlint": "oxlint",
    "test:oxfmt": "oxfmt --check .",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt ."
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
