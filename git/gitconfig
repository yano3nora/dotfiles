[core]
  autocrlf = false
  quotepath = false
  ignorecase = false
  # https://raw.github.com/github/gitignore/cdd9e946da421758c6f42c427c7bc65c8326155d/Global/macOS.gitignore
  excludesfile = ~/.gitignore_global
[color]
  ui = true
[user]
  name = yano3nora
	email = 18728262+yano3nora@users.noreply.github.com
[init]
  defaultBranch = main
[alias]
  fetcha = fetch --verbose --prune --all
  st = status
  co = checkout
  ad = add -A
  comt = commit -m
  br = branch
  cpick = cherry-pick
  # 意図: checkout せずに local branch を origin の最新へ fast-forward する。
  ff = "!f() { [ -n \"$1\" ] || { echo 'usage: git ff <branch>  (specify the branch to fast-forward)' >&2; exit 1; }; git fetch origin \"refs/heads/$1:refs/heads/$1\"; }; f"
  # https://qiita.com/take_3/items/d56514cc61d8f7e2e13c
  wdiff = diff --no-ext-diff --color-words --word-diff-regex='[A-Za-z]+|[0-9]+|[^-¿][-¿]*'
  logs = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'

[push]
  default = current
[core]
  pager = hunk pager --no-transparent-bg
[merge]
    conflictStyle = zdiff3
