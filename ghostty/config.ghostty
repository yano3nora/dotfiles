# テーマ
theme = tokyonight

# フォント
font-family = "JetBrains Mono"
font-family = "BIZ UDGothic Bold"
font-size = 12
font-thicken = true

# 背景透過
background-opacity = 0.85
background-blur-radius = 20

# 非アクティブペインを暗く
unfocused-split-opacity = 0.7

# カーソル
cursor-opacity = 0.8
cursor-color = ffffff

# ウィンドウ
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = always

# macOS 設定
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

# ペイン分割
keybind = cmd+t=new_split:down
keybind = cmd+shift+t=new_split:right

# ペイン移動
keybind = ctrl+[=goto_split:previous
keybind = ctrl+]=goto_split:next

# ペインリサイズ
keybind = ctrl+shift+[=resize_split:left,40
keybind = ctrl+shift+]=resize_split:right,40
keybind = ctrl+cmd+[=resize_split:up,40
keybind = ctrl+cmd+]=resize_split:down,40

# フルスクリーン抑止
keybind = cmd+enter=unbind
