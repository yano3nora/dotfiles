# テーマ
theme = tokyonight

# フォント
font-family = "JetBrains Mono"
font-family = "BIZ UDGothic Bold"
font-size = 13
font-thicken = true

# 背景透過
# background-opacity = 0.85
background-blur = false

# 非アクティブペインを暗く
unfocused-split-opacity = 0.9

# カーソル
cursor-opacity = 0.8
cursor-color = ffffff

# ウィンドウ
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = always

# macOS 設定
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

# ペイン分割
keybind = cmd+t=new_split:down
keybind = cmd+shift+t=new_split:right

# ペイン移動
keybind = ctrl+[=goto_split:previous
keybind = ctrl+]=goto_split:next

# ペインリサイズ
keybind = ctrl+shift+[=resize_split:left,40
keybind = ctrl+shift+]=resize_split:right,40
keybind = ctrl+cmd+[=resize_split:up,40
keybind = ctrl+cmd+]=resize_split:down,40

# フルスクリーン抑止
keybind = cmd+enter=unbind

# undo/redo を coda へ透過 (代償: Ghostty のタブ閉じ取り消しを失う)
keybind = super+z=unbind
keybind = super+shift+z=unbind

# cmd+↑/↓ を coda へ透過 (代償: shell での jump_to_prompt を失う)
keybind = super+arrow_up=unbind
keybind = super+arrow_down=unbind
keybind = super+shift+arrow_up=unbind
keybind = super+shift+arrow_down=unbind

# ctrl + h 抑止 + coda へ届かせる
# cmd+h: ignore では届かないので、kitty protocol のエンコード
# (h=codepoint 104, modifier 9 = 1+super) を text: で直接送りつける
keybind = super+h=text:\x1b[104;9u
