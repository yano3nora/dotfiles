#!/usr/bin/env zsh
set -euo pipefail
# posix_traps の理由: zsh 既定では set -e による終了時に EXIT trap が走らず、作業ディレクトリが残る。
setopt posix_traps

# ppt2png - pptx / pdf の指定ページを指定倍率の png に書き出す。
# 出力先は入力と同じ場所の <stem>_p<N>.png。既存ファイルは上書きする。
# 前提: brew install poppler で pdftoppm / pdfinfo が使えること。
# pptx は Microsoft PowerPoint を AppleScript で操作して PDF 化する。

usage() {
  cat <<'USAGE'
Usage:
  ppt2png -s <scale> <input.pptx|input.pdf> <page>...

  -s <scale>  倍率。2 で Retina 向けの 2x。小数も可。必須。
  page は 1 始まり。"1 2 6" や "1-3" のように指定する。

Example:
  ppt2png -s 2 slides.pptx 1-3 6   # -> slides_p1.png ... slides_p6.png
USAGE
}

# PDF は 72pt/inch なので、dpi = 72 x 倍率で描画すると縦横が倍率どおりになる。
readonly BASE_DPI=72

# PowerPoint は App Sandbox 内で動く。コンテナ外のファイルを開くと「アクセス権を付与」の
# ダイアログで止まる。コンテナ内へコピーしてから開けば、ダイアログ無しで変換できる。
readonly PPT_CONTAINER="$HOME/Library/Containers/com.microsoft.Powerpoint/Data/tmp"

# trap は関数の外で登録する。理由: zsh は関数内の EXIT trap を関数終了時に実行する。
work_dir=""
trap '[[ -n "$work_dir" ]] && rm -rf -- "$work_dir"' EXIT

# 展開前に上限を確認する。理由: "1-999999999" のような指定で全件展開するとメモリを食う。
expand_pages() {
  local page_count="$1"
  shift
  local spec lo hi
  for spec in "$@"; do
    if [[ "$spec" =~ '^[0-9]+$' ]]; then
      lo="$spec"
      hi="$spec"
    elif [[ "$spec" =~ '^([0-9]+)-([0-9]+)$' ]]; then
      lo="${match[1]}"
      hi="${match[2]}"
    else
      echo "❌ ページ指定が不正: $spec" >&2
      return 1
    fi
    if (( lo < 1 || hi > page_count || lo > hi )); then
      echo "❌ ページ範囲外: $spec (1-$page_count)" >&2
      return 1
    fi
    seq "$lo" "$hi"
  done
}

pptx_to_pdf() {
  local src="$1"
  local dest="$2"

  # save の保存先は POSIX file 型で渡す。文字列パスだとエラー無しで無視される。
  # 同名の資料が開いている場合は中断する。理由: close saving no で未保存の編集を失う。
  osascript - "$src" "$dest" <<'APPLESCRIPT'
on run argv
  set src to POSIX file (item 1 of argv)
  set dest to POSIX file (item 2 of argv)
  set srcName to name of (info for src)
  with timeout of 300 seconds
    tell application "Microsoft PowerPoint"
      launch
      if exists presentation srcName then
        error "PowerPoint で開いている資料は変換できない。閉じてから再実行: " & srcName
      end if
      open src
      set doc to active presentation
      -- save 失敗時も閉じる。理由: 開いたままだと次回が同名検出で拒否される。
      try
        save doc in dest as save as PDF
      on error msg number num
        close doc saving no
        error msg number num
      end try
      close doc saving no
    end tell
  end timeout
end run
APPLESCRIPT
}

main() {
  local scale=""
  local opt
  while getopts "s:" opt; do
    case "$opt" in
      s) scale="$OPTARG" ;;
      *) usage >&2; return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  if [[ -z "$scale" || $# -lt 2 ]]; then
    usage >&2
    return 1
  fi
  [[ "$scale" =~ '^[0-9]+(\.[0-9]+)?$' ]] || { echo "❌ 倍率が不正: $scale" >&2; return 1; }
  local dpi
  # 0 は awk 側で弾く。理由: 正規表現だけでは "0" や "0.0" を除外できない。
  dpi="$(awk -v b="$BASE_DPI" -v s="$scale" 'BEGIN { d = b * s; if (d <= 0) exit 1; printf "%.6f", d }')" \
    || { echo "❌ 倍率は 0 より大きい値: $scale" >&2; return 1; }

  for cmd in pdftoppm pdfinfo; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "❌ brew install poppler が必要: $cmd" >&2; return 1; }
  done

  local input="${1:A}"
  shift
  [[ -f "$input" ]] || { echo "❌ ファイルが見つからない: $input" >&2; return 1; }

  local stem="${input:r}"
  local pdf="$input"

  case "${input:e:l}" in
    pdf) ;;
    pptx|ppt)
      [[ -d "$PPT_CONTAINER" ]] || { echo "❌ PowerPoint のコンテナが無い: $PPT_CONTAINER" >&2; return 1; }
      work_dir="$(mktemp -d "$PPT_CONTAINER/ppt2png.XXXXXX")"
      # ファイル名は変えない。理由: 開いている資料の検出を名前で行う。
      cp -- "$input" "$work_dir/${input:t}"
      pdf="$work_dir/${input:t:r}.pdf"
      pptx_to_pdf "$work_dir/${input:t}" "$pdf"
      [[ -f "$pdf" ]] || { echo "❌ PowerPoint から PDF を書き出せなかった: $input" >&2; return 1; }
      ;;
    *)
      echo "❌ 未対応の拡張子: $input (pptx / ppt / pdf)" >&2
      return 1
      ;;
  esac

  local page_count
  page_count="$(pdfinfo "$pdf" | awk '/^Pages:/ {print $2}')"

  local -a pages
  pages=("${(@f)$(expand_pages "$page_count" "$@")}")

  local page out
  for page in "${pages[@]}"; do
    out="${stem}_p${page}"
    # -singlefile で連番の桁揃えを避け、出力名を <stem>_p<N>.png に固定する。
    pdftoppm -png -r "$dpi" -f "$page" -l "$page" -singlefile "$pdf" "$out"
    echo "✅ Generated: ${out}.png"
  done
}

main "$@"
