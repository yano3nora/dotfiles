#!/usr/bin/env zsh
set -euo pipefail

# dots - このリポジトリの設定ファイルをローカル環境へ安全に適用する。
# 方針:
# - link は symlink 作成だけを行う。依存確認は doctor に分離する。
# - 既存ファイルは黙って上書きせず、timestamp 付き .bak に退避する。
# - 実体パスは ~/.config/dotfiles に集約し、各設定はそこから symlink する。

DOTFILES_NAME="dotfiles"
DOTFILES_CONFIG_LINK="$HOME/.config/$DOTFILES_NAME"

# このスクリプトが symlink 経由で呼ばれても、実体の repo root を推定する。
SCRIPT_PATH="${0:A}"
DOTFILES_ROOT="${SCRIPT_PATH:h:h}"

usage() {
  cat <<'USAGE'
Usage:
  dots link               Link managed dotfiles
  dots doctor             Check required commands
  dots addbin <name>      Create an executable bin/<name> template
  dots project [--typescript] [--react] [dir]
                          Create a new project template
  dots help               Show this help
USAGE
}

info() {
  printf '==> %s\n' "$*"
}

warn() {
  printf 'WARN: %s\n' "$*" >&2
}

backup_path() {
  local target="$1"
  printf '%s.bak.%s' "$target" "$(date +%Y%m%d%H%M%S)"
}

ensure_parent_dir() {
  local target="$1"
  mkdir -p "${target:h}"
}

link_path() {
  local src="$1"
  local dest="$2"

  if [[ ! -e "$src" ]]; then
    warn "source not found: $src"
    return 1
  fi

  ensure_parent_dir "$dest"

  # すでに期待通りの symlink なら何もしない。冪等性を保つための最重要分岐。
  if [[ -L "$dest" && "${dest:A}" == "${src:A}" ]]; then
    info "already linked: $dest -> $src"
    return 0
  fi

  if [[ -e "$dest" || -L "$dest" ]]; then
    local backup
    backup="$(backup_path "$dest")"
    info "backup: $dest -> $backup"
    mv "$dest" "$backup"
  fi

  ln -s "$src" "$dest"
  info "linked: $dest -> $src"
}

link_bin_files() {
  local src dest name
  mkdir -p "$HOME/.local/bin"

  for src in "$DOTFILES_ROOT"/bin/*; do
    [[ -f "$src" && -x "$src" ]] || continue
    name="${src:t}"
    dest="$HOME/.local/bin/$name"
    link_path "$src" "$dest"
  done
}

link_all() {
  info "dotfiles root: $DOTFILES_ROOT"

  link_path "$DOTFILES_ROOT" "$DOTFILES_CONFIG_LINK"
  link_path "$DOTFILES_ROOT/git/gitconfig" "$HOME/.gitconfig"
  link_path "$DOTFILES_ROOT/git/gitignore_global" "$HOME/.gitignore_global"
  link_path "$DOTFILES_ROOT/zsh/zshrc" "$HOME/.zshrc"
  link_path "$DOTFILES_ROOT/mise/config.toml" "$HOME/.config/mise/config.toml"
  link_path "$DOTFILES_ROOT/coda/config.toml" "$HOME/.config/coda/config.toml"
  link_path "$DOTFILES_ROOT/coda/bindings.json" "$HOME/.config/coda/bindings.json"
  link_path "$DOTFILES_ROOT/vscode/settings.json" "$HOME/Library/Application Support/Code/User/settings.json"
  link_path "$DOTFILES_ROOT/vscode/keybindings.json" "$HOME/Library/Application Support/Code/User/keybindings.json"
  link_path "$DOTFILES_ROOT/ghostty/config.ghostty" "$HOME/Library/Application Support/com.mitchellh.ghostty/config.ghostty"
  link_path "$DOTFILES_ROOT/lazygit/config.yml" "$HOME/Library/Application Support/lazygit/config.yml"
  link_path "$DOTFILES_ROOT/leaf/config.toml" "$HOME/.config/leaf/config.toml"
  link_path "$DOTFILES_ROOT/ai/instructions.md" "$HOME/.codex/instructions.md"
  link_path "$DOTFILES_ROOT/ai/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
  link_path "$DOTFILES_ROOT/nvim/lua/config/options.lua" "$HOME/.config/nvim/lua/config/options.lua"
  link_path "$DOTFILES_ROOT/nvim/lua/config/keymaps.lua" "$HOME/.config/nvim/lua/config/keymaps.lua"
  link_path "$DOTFILES_ROOT/nvim/lua/config/autocmds.lua" "$HOME/.config/nvim/lua/config/autocmds.lua"
  link_path "$DOTFILES_ROOT/nvim/lua/plugins/blink.lua" "$HOME/.config/nvim/lua/plugins/blink.lua"
  link_bin_files
}

doctor() {
  local missing=0
  local command_name
  local commands=(
    zsh
    code
    nvim
    lazygit
    delta
    trash
    fd
    fzf
    php
    peco
    direnv
    mise
    gdate
    convmv
    zip
    ffmpeg
  )
  local mise_bins=(
    jq
    rg
    deno
    java
  )

  info "checking commands"
  for command_name in "${commands[@]}"; do
    if command -v "$command_name" >/dev/null 2>&1; then
      printf 'ok   %s\n' "$command_name"
    else
      printf 'miss %s\n' "$command_name"
      missing=1
    fi
  done

  info "checking mise-managed commands"
  for command_name in "${mise_bins[@]}"; do
    # mise-managed tools may not be on PATH before a shell reload, so ask mise directly.
    if mise which "$command_name" >/dev/null 2>&1; then
      printf 'ok   %s (mise)\n' "$command_name"
    else
      printf 'miss %s (mise)\n' "$command_name"
      missing=1
    fi
  done

  if [[ "$missing" -ne 0 ]]; then
    warn "some commands are missing"
    return 1
  fi

  info "all required commands are available"
}

addbin() {
  if [[ $# -ne 1 ]]; then
    usage >&2
    return 1
  fi

  local name="$1"

  if [[ "$name" == */* || "$name" == .* || ! "$name" =~ '^[A-Za-z0-9._-]+$' ]]; then
    warn "invalid bin name: $name"
    return 1
  fi

  local file="$DOTFILES_ROOT/bin/$name"
  if [[ -e "$file" ]]; then
    warn "already exists: $file"
    return 1
  fi

  cat > "$file" <<EOF_BIN
#!/usr/bin/env zsh
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  $name
USAGE
}

main() {
  usage
}

main "\$@"
EOF_BIN

  chmod +x "$file"
  info "created: $file"
  info "next: dots link"
}

copy_template_file() {
  local src="$1"
  local dest="$2"

  if [[ ! -e "$src" ]]; then
    warn "template not found: $src"
    return 1
  fi

  ensure_parent_dir "$dest"

  # 新規 project への初期配置でも、既存ファイルはプロジェクト固有の真実なので上書きしない。
  if [[ -e "$dest" || -L "$dest" ]]; then
    info "skip existing: $dest"
    return 0
  fi

  cp "$src" "$dest"
  info "created: $dest"
}

copy_template_dir_files() {
  local src_dir="$1"
  local dest_dir="$2"
  local src name

  if [[ ! -d "$src_dir" ]]; then
    warn "template dir not found: $src_dir"
    return 1
  fi

  mkdir -p "$dest_dir"

  for src in "$src_dir"/*(.N); do
    [[ -f "$src" ]] || continue
    name="${src:t}"
    copy_template_file "$src" "$dest_dir/$name"
  done
}

copy_readme_template() {
  local target_dir="$1"
  local src="$DOTFILES_ROOT/project/_README.md"
  local dest="$target_dir/README.md"
  local project_name="${target_dir:t}"

  if [[ ! -e "$src" ]]; then
    warn "template not found: $src"
    return 1
  fi

  ensure_parent_dir "$dest"

  # README はテンプレートの先頭タイトルだけ対象ディレクトリ名へ差し替える。
  # 本文は project/_README.md を編集すれば全 project 初期値に反映できる。
  if [[ -e "$dest" || -L "$dest" ]]; then
    info "skip existing: $dest"
    return 0
  fi

  {
    printf '%s\n' "$project_name"
    tail -n +2 "$src"
  } > "$dest"
  info "created: $dest"
}

package_name_from_dir() {
  local project_name="$1"
  local package_name

  # npm package name として最低限安全な値に寄せる。
  # README の見出しは人間向けに元の directory 名を使うが、package.json は npm の制約が強い。
  package_name="$(printf '%s' "$project_name" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9._~-]+/-/g; s/^-+//; s/-+$//')"

  if [[ -z "$package_name" ]]; then
    package_name="new-project"
  fi

  printf '%s\n' "$package_name"
}

copy_package_json_template() {
  local target_dir="$1"
  local src="$DOTFILES_ROOT/project/typescript/package.json"
  local dest="$target_dir/package.json"
  local package_name

  if [[ ! -e "$src" ]]; then
    warn "template not found: $src"
    return 1
  fi

  ensure_parent_dir "$dest"

  # package.json は project 固有の依存・scripts が育ちやすいので、既存ファイルは絶対に上書きしない。
  if [[ -e "$dest" || -L "$dest" ]]; then
    info "skip existing: $dest"
    return 0
  fi

  package_name="$(package_name_from_dir "${target_dir:t}")"
  sed "s/__PROJECT_NAME__/$package_name/g" "$src" > "$dest"
  info "created: $dest"
}

copy_typescript_templates() {
  local target_dir="$1"
  local react="$2"

  copy_template_file "$DOTFILES_ROOT/project/typescript/.vscode/settings.json" "$target_dir/.vscode/settings.json"
  copy_template_file "$DOTFILES_ROOT/project/typescript/.vscode/extensions.json" "$target_dir/.vscode/extensions.json"
  copy_template_file "$DOTFILES_ROOT/project/typescript/.oxfmtrc.json" "$target_dir/.oxfmtrc.json"
  if [[ "$react" == "1" ]]; then
    # --react は React project 向けの oxlint 初期値を選ぶだけに留める。
    # tsconfig や framework 設定は Next.js / Vite / library で正解が割れるため入れない。
    copy_template_file "$DOTFILES_ROOT/project/typescript-react/.oxlintrc.json" "$target_dir/.oxlintrc.json"
  else
    copy_template_file "$DOTFILES_ROOT/project/typescript/.oxlintrc.json" "$target_dir/.oxlintrc.json"
  fi
  copy_template_file "$DOTFILES_ROOT/project/typescript/vitest.config.ts" "$target_dir/vitest.config.ts"
  copy_template_file "$DOTFILES_ROOT/project/typescript/.npmrc" "$target_dir/.npmrc"
  copy_package_json_template "$target_dir"
}

project() {
  local typescript=0
  local react=0
  local target="."
  local targets=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --typescript)
        typescript=1
        ;;
      --react)
        react=1
        ;;
      --)
        shift
        break
        ;;
      -*)
        warn "unknown option: $1"
        usage >&2
        return 1
        ;;
      *)
        targets+=("$1")
        ;;
    esac
    shift
  done

  while [[ $# -gt 0 ]]; do
    targets+=("$1")
    shift
  done

  if [[ "${#targets[@]}" -gt 1 ]]; then
    usage >&2
    return 1
  fi

  if [[ "$react" == "1" && "$typescript" != "1" ]]; then
    warn "--react requires --typescript"
    return 1
  fi

  if [[ "${#targets[@]}" -eq 1 ]]; then
    target="${targets[1]}"
  fi

  local target_dir="${target:A}"

  mkdir -p "$target_dir"
  info "project root: $target_dir"

  # Project templates are copied, not linked, because each project must rewrite them to its own context.
  copy_template_file "$DOTFILES_ROOT/project/mise.toml" "$target_dir/mise.toml"
  copy_template_file "$DOTFILES_ROOT/project/.editorconfig" "$target_dir/.editorconfig"
  copy_template_file "$DOTFILES_ROOT/project/.gitignore" "$target_dir/.gitignore"
  copy_template_file "$DOTFILES_ROOT/project/.gitattributes" "$target_dir/.gitattributes"
  copy_readme_template "$target_dir"
  copy_template_file "$DOTFILES_ROOT/project/AGENTS.md" "$target_dir/AGENTS.md"
  copy_template_file "$DOTFILES_ROOT/project/CLAUDE.md" "$target_dir/CLAUDE.md"
  copy_template_dir_files "$DOTFILES_ROOT/project/docs" "$target_dir/docs"

  if [[ "$typescript" == "1" ]]; then
    copy_typescript_templates "$target_dir" "$react"
  fi

  info "next: edit TODOs in AGENTS.md, README.md, and docs/"
}

case "${1:-help}" in
  link)
    link_all
    ;;
  doctor)
    doctor
    ;;
  addbin)
    shift
    addbin "$@"
    ;;
  project)
    shift
    project "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
