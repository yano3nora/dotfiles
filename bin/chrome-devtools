#!/usr/bin/env zsh
# chrome-devtools CLI を Node 24 固定で起動する共通入口 (ai/README.md 参照)。
# 理由: 本体の npm shim は PATH の node で動き、.node-version が 18 以下の project では起動できない。
# 本体の同名 shim は mise/mac.toml の shims.exclude で作らせない。本体を config で active にもしない。
# 理由: active にすると本体の実 bin dir が ~/.local/bin より前に出て、この wrapper が負ける。
exec mise exec node@24 npm:chrome-devtools-mcp@latest -- chrome-devtools "$@"
