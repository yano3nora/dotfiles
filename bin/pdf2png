#!/usr/bin/env bash
set -euo pipefail

# pdf2png - pdf の指定ページを指定倍率の png に書き出す。
# 出力先は入力と同じ場所の <stem>_p<N>.png。既存ファイルは上書きする。
# 前提: poppler の pdftoppm / pdfinfo が PATH にあること。
# bash 3.2 互換で書く。理由: macOS 標準 bash と git bash の両方で動かすため。

usage() {
  cat <<'USAGE'
Usage:
  pdf2png -s <scale> <input.pdf> <page>...

  -s <scale>  倍率。2 で Retina 向けの 2x。小数も可。必須。
  page は 1 始まり。"1 2 6" や "1-3" のように指定する。

Example:
  pdf2png -s 2 slides.pdf 1-3 6   # -> slides_p1.png ... slides_p6.png

Install poppler:
  macOS:   brew install poppler
  Windows: winget install oschwartz10612.Poppler
USAGE
}

# PDF は 72pt/inch なので、dpi = 72 x 倍率で描画すると縦横が倍率どおりになる。
readonly BASE_DPI=72

# 展開前に上限を確認する。理由: "1-999999999" のような指定で全件展開するとメモリを食う。
expand_pages() {
  local page_count="$1"
  shift
  local spec lo hi
  for spec in "$@"; do
    if [[ "$spec" =~ ^[0-9]+$ ]]; then
      lo="$spec"
      hi="$spec"
    elif [[ "$spec" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      lo="${BASH_REMATCH[1]}"
      hi="${BASH_REMATCH[2]}"
    else
      echo "❌ ページ指定が不正: $spec" >&2
      return 1
    fi
    # 10 進で比較する。理由: bash は "010" を 8 進として扱い、seq の解釈と食い違う。
    lo=$((10#$lo))
    hi=$((10#$hi))
    if (( lo < 1 || hi > page_count || lo > hi )); then
      echo "❌ ページ範囲外: $spec (1-$page_count)" >&2
      return 1
    fi
    seq "$lo" "$hi"
  done
}

main() {
  local scale=""
  local opt
  while getopts "s:" opt; do
    case "$opt" in
      s) scale="$OPTARG" ;;
      *) usage >&2; return 1 ;;
    esac
  done
  shift $((OPTIND - 1))

  if [[ -z "$scale" || $# -lt 2 ]]; then
    usage >&2
    return 1
  fi
  [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]] || { echo "❌ 倍率が不正: $scale" >&2; return 1; }
  local dpi
  # 0 は awk 側で弾く。理由: 正規表現だけでは "0" や "0.0" を除外できない。
  dpi="$(awk -v b="$BASE_DPI" -v s="$scale" 'BEGIN { d = b * s; if (d <= 0) exit 1; printf "%.6f", d }')" \
    || { echo "❌ 倍率は 0 より大きい値: $scale" >&2; return 1; }

  local cmd
  for cmd in pdftoppm pdfinfo; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      echo "❌ poppler が必要: $cmd が見つからない" >&2
      usage >&2
      return 1
    fi
  done

  local input="$1"
  shift
  [[ -f "$input" ]] || { echo "❌ ファイルが見つからない: $input" >&2; return 1; }
  # "-" 始まりの名前は poppler にオプションと誤認されるので ./ を付ける。
  [[ "$input" == -* ]] && input="./$input"

  local ext
  ext="$(printf '%s' "${input##*.}" | tr '[:upper:]' '[:lower:]')"
  [[ "$ext" == "pdf" ]] || { echo "❌ 未対応の拡張子: $input (pdf のみ)" >&2; return 1; }

  local stem="${input%.*}"

  local page_count
  # tr で CR を落とす。理由: Windows 版 pdfinfo は CRLF を返すことがある。
  page_count="$(pdfinfo "$input" | tr -d '\r' | awk '/^Pages:/ {print $2}')"

  local pages
  pages="$(expand_pages "$page_count" "$@")"

  local page out
  for page in $pages; do
    out="${stem}_p${page}"
    # -singlefile で連番の桁揃えを避け、出力名を <stem>_p<N>.png に固定する。
    pdftoppm -png -r "$dpi" -f "$page" -l "$page" -singlefile "$input" "$out"
    echo "✅ Generated: ${out}.png"
  done
}

main "$@"
